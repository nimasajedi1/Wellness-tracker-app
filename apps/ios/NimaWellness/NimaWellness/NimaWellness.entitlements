<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- HealthKit read access (HEALTH-001, P1). Remove if you disable the
	     Health integration. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- Shared store for quick-action intents and interactive widgets
	     (DEVICE-003). Xcode registers the group with your team on first
	     automatic-signing build; keep the ID in sync with
	     PersistenceFactory.appGroupIdentifier. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.nimasajedi.nimawellness</string>
	</array>
</dict>
</plist>
